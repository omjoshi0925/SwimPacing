@article{kolmogorov2021metabolic,
  author  = {Kolmogorov, S. and Vorontsov, A. and Vilas-Boas, J. P.},
  title   = {Metabolic Power, Active Drag, Mechanical and Propelling Efficiency
             of Elite Swimmers at 100 Meter Events in Different Competitive
             Swimming Techniques},
  journal = {Applied Sciences},
  volume  = {11}, number = {18}, pages = {8511}, year = {2021},
  doi     = {10.3390/app11188511},
  note    = {[full text read] Open access. n = 8 world top-10 swimmers.
             Mechanical efficiency 0.049-0.068, THREE TO FOUR TIMES LOWER than
             zamparo2005energy. Propelling efficiency 0.65-0.71. Drag
             coefficient 0.33-0.61. The efficiency disagreement is definitional
             and is why k is not identifiable from the literature.}
}

@article{capelli1998energetics,
